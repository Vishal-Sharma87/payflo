# ============================================================================
# PayFlo Environment Configuration
#
# Copy this file to ".env" before running the project.
#
# This file is consumed by:
#   • Docker Compose
#   • Spring Boot (application.yml)
#   • Startup scripts
# ============================================================================

# *************************     Application        *********************


# Spring Boot application name.
APPLICATION_NAME=payflo

# *************************    Transaction Status Check Messages       *********************

PAYFLO_STATUS_MESSAGE_PROCESSING=Your payment is being processed.
PAYFLO_STATUS_MESSAGE_COMPLETED=Your payment was completed successfully.
PAYFLO_STATUS_MESSAGE_FAILED=Your payment failed. Please try again.
PAYFLO_STATUS_MESSAGE_TIMED_OUT=Your payment timed out. Please try again.







# *************************Exception-Messages*********************

PAYFLO_EXCEPTION_MESSAGE_TRANSACTION_NOT_FOUND=No transaction found for the given transaction ID.
PAYFLO_EXCEPTION_MESSAGE_MALFORMED_REQUEST_BODY=The request body is malformed or contains invalid data.


# *************************      Upi details exception messages           *********************

PAYFLO_EXCEPTION_MESSAGE_VPA_SEPARATOR_COUNT_MISMATCH=Invalid VPA format. A VPA must contain exactly one '@' separator.
PAYFLO_EXCEPTION_MESSAGE_VPA_INVALID_IDENTIFIER_FORMAT=Invalid VPA identifier. Must be 3-60 characters long and contain only lowercase letters, digits, dots, hyphens, or underscores.
PAYFLO_EXCEPTION_MESSAGE_VPA_INVALID_PAYMENT_SERVICE_PROVIDER_FORMAT=Invalid VPA payment service provider format. Must be 3-39 characters long and contain only lowercase letters.
PAYFLO_EXCEPTION_MESSAGE_VPA_UNKNOWN_PAYMENT_SERVICE_PROVIDER=The specified VPA payment service provider is not supported.

# *************************      Card details exception messages           *********************

PAYFLO_EXCEPTION_MESSAGE_INVALID_CARD_NUMBER_FORMAT=Card number must be 15 to 16 digits.
PAYFLO_EXCEPTION_MESSAGE_INVALID_CARD_NUMBER=Invalid card number.
PAYFLO_EXCEPTION_MESSAGE_EXPIRED_CARD=This card has expired.
PAYFLO_EXCEPTION_MESSAGE_INVALID_CVV_FORMAT=CVV must be 3 or 4 digits.





# *************************       Notification Message template            *********************

PAYFLO_NOTIFICATION_TEMPLATE_PAYMENT_INITIATED=Your payment with transaction ID %s has been initiated.
PAYFLO_NOTIFICATION_TEMPLATE_PAYMENT_COMPLETED=Your payment with transaction ID %s has been completed successfully.
PAYFLO_NOTIFICATION_TEMPLATE_PAYMENT_FAILED=Your payment with transaction ID %s has failed.
PAYFLO_NOTIFICATION_TEMPLATE_PAYMENT_TIMED_OUT=Your payment with transaction ID %s has timed out.



# *************************   Payment Service Providers Used              *********************
PAYFLO_VPA_PAYMENT_SERVICE_PROVIDERS=okaxis,okhdfcbank,oksbi,okicici,ybl,axl,ibl,paytm,apl,upi,sbi,airtel,kotak,icici

# *************************   Payment Configs             *********************
PAYMENT_TIMEOUT_BUFFER_MINUTES=10

# *************************  Redis TTL             *********************
PAYMENT_STATUS_TTL_HOURS=1


# ***********************     MySQL  ****************

# JDBC URL used by Spring Boot to connect to MySQL.
MYSQL_URL=jdbc:mysql://localhost:3306/payflo

# Database automatically created when the MySQL container starts.
MYSQL_DATABASE=payflo

# MySQL user used by the application.
MYSQL_USER=root

# Password for the MySQL user.
#
# Docker Compose uses this to initialize MySQL.
# Spring Boot also uses this to authenticate.
MYSQL_ROOT_PASSWORD=changeme


# ***********************     Redis  ****************


REDIS_HOST=localhost
REDIS_PORT=6379

REDIS_PAYMENT_TRANSACTION_HASH_PREFIX=payflo:payment-transaction:
REDIS_PROCESSING_TRANSACTIONS_ZSET_KEY=payflo:processing-payment-transactions:by-started-at
REDIS_PAYMENT_TRANSACTION_HASH_STATUS_KEY=transactionStatus

# ***********************     Redis Hash keys   ****************

PAYMENT_INITIATED_NOTIFICATION_HASH_KEY=notification:payment-initiated
PAYMENT_COMPLETED_NOTIFICATION_HASH_KEY=notification:payment-completed
PAYMENT_FAILED_NOTIFICATION_HASH_KEY=notification:payment-failed
PAYMENT_TIMED_OUT_NOTIFICATION_HASH_KEY=notification:payment-timed-out


# *******************      Kafka Configs           *********************



KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=payflo-consumer-group
KAFKA_TRUSTED_PACKAGES=com.vishal.payflo.kafka.events

# Docker container name used by startup scripts.
KAFKA_CONTAINER=payflo-kafka

# Unique Kafka cluster identifier.
# Change only when creating a completely new Kafka cluster.
KAFKA_CLUSTER_ID=a5ff53ea-345d-4661-bf5e-51b3a696265c



# ****************          Kafka topic configs           *********************


# Number of partitions created for each application topic.
KAFKA_TOPIC_PARTITIONS=3

# Replication factor for created topics.
# Keep this as 1 for local single-node development.
KAFKA_TOPIC_REPLICATION_FACTOR=1

PAYFLO_KAFKA_TOPIC_PAYMENT_INITIATED=payflo.payment-initiated
PAYFLO_KAFKA_TOPIC_NOTIFICATION_PAYMENT_INITIATED=payflo.notification.payment-initiated
PAYFLO_KAFKA_TOPIC_PAYMENT_RECEIVED=payflo.payment-received
PAYFLO_KAFKA_TOPIC_NOTIFICATION_PAYMENT_COMPLETED=payflo.notification.payment-completed
PAYFLO_KAFKA_TOPIC_PAYMENT_TIMED_OUT=payflo.payment-timed-out
PAYFLO_KAFKA_TOPIC_NOTIFICATION_PAYMENT_TIMED_OUT=payflo.notification.payment-timed-out
PAYFLO_KAFKA_TOPIC_PAYMENT_FAILED=payflo.payment-failed
PAYFLO_KAFKA_TOPIC_NOTIFICATION_PAYMENT_FAILED=payflo.notification.payment-failed
PAYFLO_KAFKA_TOPIC_DLT=payflo.DLT



# ***********************    Schedular properties      ****************
TRANSACTION_MONITOR_FIXED_DELAY_MS=30000


# ***********************    JPA / Hibernate     ****************
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true